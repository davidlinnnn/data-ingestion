      "critical": false
    },
    {
      "id": "H01",
      "role": "section_header",
      "column": "left",
      "text": "2 OVERVIEW",
      "native_line_indexes": [
        16
      ],
      "bbox": [
        48.605003356933594,
        251.06268310546875,
        117.85880279541016,
