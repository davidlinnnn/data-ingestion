{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "bench",
    "namespace": "pdf-checkpoint-performance"
  },
  "spec": {
    "nodeSelector": {
      "kubernetes.io/hostname": "internal-a2a-vs6-local-worker2"
    },
    "containers": [
      {
        "name": "bench",
        "image": "pdf-checkpoint-prototype:linux-v2",
        "imagePullPolicy": "Never",
        "command": [
          "/experiment/.venv/bin/python",
          "-c",
          "import time; time.sleep(86400)"
        ],
        "envFrom": [
          {
            "secretRef": {
              "name": "store-access"
            }
          }
        ],
        "env": [
          {
            "name": "AWS_DEFAULT_REGION",
            "value": "us-east-1"
          }
        ],
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "128Mi"
          },
          "limits": {
            "memory": "5Gi"
          }
        }
      }
    ]
  }
}