// The authorization model, model-1 (authorization design §3.1, #113): its one normative
// definition. The pilot's allow-all provider does not evaluate it; the first real provider
// (#115 or #86) does.

definition user {}
definition client {}
definition source {}

definition resource {
    relation maintainer: source
    relation reader: user | client

    permission manage = maintainer
    permission place  = maintainer
    permission read   = reader
}
