#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml==6.0.3"]
# ///
"""Keep Processing Profile version labels honest (ADR-0010), over what the branch changes.

    check-method-versions [BASE]            (default origin/dev)
    check-method-versions --released REV    print the id of each profile released at REV

A profile is released once its file is in profiles/ on the base branch: every .yaml file there
at the merge base counts. Drafts live in tests/profiles/, which these rules do not cover.
1. A change under the package of a method that a released profile lists needs a higher
   VERSION in that package's __init__.py in the same diff.
2. A released profile file is never modified, renamed or deleted; new profile files pass.
3. A branch based on release/* changes nothing under methods/: a patch build must reuse what
   its Processing Profile version registered, so a method change goes to dev as a new version.
"""

import re
import subprocess
import sys

import yaml

PROFILES = "src/kp_canonicalization/profiles/"
METHODS = "src/kp_canonicalization/methods/"


def git(*args: str) -> str:
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout


def version(rev: str, package: str) -> int | None:
    try:
        text = git("show", f"{rev}:{METHODS}{package}/__init__.py")
    except subprocess.CalledProcessError:
        return None
    m = re.search(r"^VERSION\s*=\s*(\d+)\s*$", text, re.M)
    return int(m.group(1)) if m else None


def released_profiles(rev: str) -> dict[str, list[str]]:
    """Profile path -> method ids, for each profile released at rev."""
    released = {}
    for path in git("ls-tree", "--name-only", rev, PROFILES).split():
        if path.endswith(".yaml"):
            doc = yaml.safe_load(git("show", f"{rev}:{path}"))
            released[path] = [ref.rsplit("@", 1)[0] for ref in doc["methods"]]
    return released


def main() -> int:
    if sys.argv[1:2] == ["--released"]:
        print(
            "\n".join(
                path[len(PROFILES) : -len(".yaml")] for path in released_profiles(sys.argv[2])
            )
        )
        return 0
    base_ref = sys.argv[1] if len(sys.argv) > 1 else "origin/dev"
    base = git("merge-base", base_ref, "HEAD").strip()
    released = released_profiles(base)

    changes = [
        line.split("\t", 1)
        for line in git("diff", "--name-status", "--no-renames", f"{base}...HEAD").splitlines()
    ]
    errors = [
        f"{path}: released profile {'deleted' if status == 'D' else 'modified'}; "
        "add a new profile version instead"
        for status, path in changes
        if path in released
    ]
    changed = {path for _, path in changes}
    if re.match(r"(origin/)?release/", base_ref):
        errors += [
            f"{path}: a release branch takes no method change; raise the method's VERSION on dev "
            "in a new profile version instead"
            for path in sorted(changed)
            if path.startswith(METHODS)
        ]
    for package in sorted({m.replace("-", "_") for ids in released.values() for m in ids}):
        if any(p.startswith(f"{METHODS}{package}/") for p in changed):
            old, new = version(base, package), version("HEAD", package)
            if old is not None and (new is None or new <= old):
                errors.append(
                    f"{METHODS}{package}/: changed without raising VERSION (still {new}); "
                    "a released profile lists this method"
                )

    print("\n".join(errors) or f"method versions ok ({len(released)} released profiles)")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
