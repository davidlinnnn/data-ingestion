#!/usr/bin/env bash
# One of CI's parallel pytest shards: `scripts/test-shard N [pytest args]`. Shards 1-3 hold the
# slowest files (their tests convert PDFs with docling on CPU); the last shard runs every other
# file, so a new test file always runs somewhere.
set -euo pipefail
cd "$(dirname "$0")/.."
shards=(
  "tests/stages/test_finalize.py tests/stages/test_accuracy.py"
  "tests/stages/test_enrich_summary.py tests/stages/test_enrich_vlm.py"
  "tests/stages/test_parse.py tests/stages/test_enrich_local.py tests/stages/test_registration.py"
)
n=$1
shift
if ((n <= ${#shards[@]})); then
  exec uv run pytest ${shards[n - 1]} "$@"
fi
exec uv run pytest $(printf -- '--ignore=%s ' ${shards[*]}) "$@"
