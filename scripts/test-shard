#!/usr/bin/env bash
# One of CI's parallel pytest shards: `scripts/test-shard N [pytest args]`. pytest-split assigns
# each test to the shard with the least duration so far, from `.test_durations`; a test missing
# from it counts as the average, so a new test always runs somewhere. CI uploads each shard's
# measured durations (artifacts `test-durations-N`); when the shards drift apart, download the
# latest run's four and commit their union as `.test_durations`. Durations measured on a Mac do
# not fit: docling on the runner's CPU is a far larger share of the time.
set -euo pipefail
cd "$(dirname "$0")/.."
n=$1
shift
exec uv run pytest --splits 4 --group "$n" --splitting-algorithm least_duration "$@"
