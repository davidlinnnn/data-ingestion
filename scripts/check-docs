#!/usr/bin/env bash
# Pre-push and CI checks for this public repo, over what the branch changes relative to BASE.
#   check-docs [BASE]    (default origin/dev)
# 0. up to date: the branch contains BASE, so it carries what parallel sessions merged.
# 1. gitleaks: secrets in the branch's commits.
# 2. check-publish: local paths, emails and secrets in added lines; in design records and ADRs
#    also unfilled placeholders, such as a {#NAME} for a ticket not yet created.
# 3. lychee: relative links and #anchors in changed Markdown files (offline).
# 4. ADR numbers: no two ADRs share a number, e.g. after a parallel session merged one.
# 5. method versions: released Processing Profiles and their methods' VERSION (ADR-0010).
# Legacy content outside the diff is not checked.
set -u
BASE=${1:-origin/dev}
cd "$(git rev-parse --show-toplevel)" || exit 2
# Outside CI, refresh BASE first so check 0 sees merges from parallel sessions.
if [ -z "${CI:-}" ] && [[ $BASE == origin/* ]]; then
  git fetch -q origin "${BASE#origin/}" || echo "fetch failed; checking against the local $BASE" >&2
fi
git rev-parse --verify -q "$BASE" >/dev/null || { echo "unknown base: $BASE" >&2; exit 2; }
status=0
step() { echo "== $1"; }
# A missing tool fails the run: pushing publishes, so CI on the PR is too late to catch a secret.
missing() { echo "$1 not installed: brew install $1 (CI pins its version in .github/workflows/docs-checks.yml)"; status=1; }

step "up to date with $BASE"
if git merge-base --is-ancestor "$BASE" HEAD; then
  echo "branch contains $BASE"
else
  echo "branch is behind $BASE: update it from $BASE, resolve any conflicts, and re-run"
  status=1
fi

step "gitleaks ($BASE..HEAD)"
if command -v gitleaks >/dev/null; then
  gitleaks git --no-banner --redact --log-opts "$BASE..HEAD" . || status=1
else
  missing gitleaks
fi

added() { git diff "$BASE...HEAD" -U0 --no-color -- "$@" | grep -E '^\+' | grep -vE '^\+\+\+ '; }
step "check-publish (added lines; placeholders refused in docs/design and docs/adr; its own patterns excluded)"
added docs/design docs/adr | scripts/check-publish - || status=1
added . ':(exclude)scripts/check-publish' ':(exclude)docs/design' ':(exclude)docs/adr' \
  | scripts/check-publish --no-placeholders - || status=1

step "lychee (changed Markdown)"
files=()
while IFS= read -r f; do files+=("$f"); done < <(git diff --name-only --diff-filter=ACMR "$BASE...HEAD" -- '*.md')
if [ ${#files[@]} -eq 0 ]; then
  echo "no Markdown changes"
elif command -v lychee >/dev/null; then
  lychee --offline --include-fragments --no-progress "${files[@]}" || status=1
else
  missing lychee
fi

step "ADR numbers unique"
dups=$(ls docs/adr | grep -oE '^[0-9]{4}' | sort | uniq -d)
if [ -n "$dups" ]; then
  echo "duplicate ADR numbers: $dups; renumber the ADR this branch adds"
  status=1
else
  echo "no duplicates"
fi

step "method versions and released profiles"
if command -v uv >/dev/null; then
  scripts/check-method-versions "$BASE" || status=1
else
  missing uv
fi

[ $status -eq 0 ] && echo "== all checks passed" || echo "== checks FAILED"
exit $status
