#!/usr/bin/env bash
# Prints the branch this one was started from. A patch branch names its Processing Profile
# version, patch/paper-pdf-<N>-<issue>-<slug>, and starts from origin/release/paper-pdf-<N>
# (docs/agents/branching.md); everything else starts from origin/dev. The name decides because
# the history cannot: a release branch is opened on a dev commit, which task branches start from too.
branch=$(git rev-parse --abbrev-ref HEAD)
if [[ $branch =~ ^patch/(paper-pdf-[0-9]+)- ]]; then
  echo "origin/release/${BASH_REMATCH[1]}"
else
  echo origin/dev
fi
